  "restructure": {
    "announced": "2021-07-09",
    "announced_by": "University Council (Chair: Prof. Julia Ojiambo)",
    "effective_from": "2021",
    "previous_structure_established": "1983",
    "summary": "Six campus colleges headed by principals were abolished. Schools and institutes ceased to be academic units; departments now report directly to faculties headed by Deans and Associate Deans. Research institutes and centres were retained as non-teaching units.",
    "legal_status": "A High Court conservatory order dated 2021-07-22 (UASU petition) temporarily suspended implementation. The faculty structure was subsequently implemented and is the structure currently in force.",
    "faculties_at_announcement": 11,
    "faculties_current": 10,
    "post_announcement_change": "Faculty of Arts and Faculty of Social Sciences were later merged into a single Faculty of Arts and Social Sciences."
  },
